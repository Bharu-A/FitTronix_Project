rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================
    // 🔐 USER AUTHENTICATION - SIMPLIFIED
    // ========================
    match /users/{userId} {
      // ✅ ALLOW creation and access to own user document
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ========================
    // 🌐 PUBLIC COLLECTIONS
    // ========================
    match /workoutCategories/{doc} { allow read: if true; }
    match /exercises/{doc} { allow read: if true; }
    match /weeklyPlans/{doc} { allow read: if true; }
    match /testimonials/{doc} { allow read: if true; }
    match /plans/{doc} { allow read: if true; }
    match /features/{doc} { allow read: if true; }
    match /motivationalQuotes/{doc} { allow read: if true; }

    // ========================
    // 📝 CMS CONTENT (ADMIN)
    // ========================
    match /content/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blogPosts/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /faqs/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /privacyPolicy/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /contactMessages/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ========================
    // 💪 WORKOUT SESSIONS
    // ========================
    match /workoutSessions/{sessionId} {
      allow create, read, update, delete: if request.auth != null;
    }

    // ========================
    // 🤖 AI TASKS
    // ========================
    match /ai_tasks/{doc} {
      allow read, write: if request.auth != null;
    }

    // ========================
    // 🏋️ WORKOUTS
    // ========================
    match /workouts/{doc} {
      allow read, write: if request.auth != null;
    }

    // ========================
    // 🔒 TEMPORARY FALLBACK
    // ========================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}